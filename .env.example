# ------------------------------------------------------------------------------
# Remote API Proxy Mode (For UI Development)
# ------------------------------------------------------------------------------
# Set REMOTE_API_MODE=true to allow temporary team members to develop UI locally
# without needing local database credentials, MongoDB, or cloud API keys.
# All backend/API calls will be proxied to LIVE_API_URL securely.

REMOTE_API_MODE=true
LIVE_API_URL=https://codealive.onrender.com

# ------------------------------------------------------------------------------
# Local Production / Full-Backend Mode (Optional)
# ------------------------------------------------------------------------------
# If REMOTE_API_MODE is false or omitted, provide real service credentials below:
# DB_URL=postgresql://user:password@localhost:5432/codealive
# MONGO_URI=mongodb+srv://...
# MONGO_DB_NAME=codealive
# R2_ACCOUNT_ID=...
# R2_ENDPOINT_URL=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=...
# R2_REGION=auto
# MAIL_SERVICE_URL=...
# MAIL_SERVICE_API_KEY=...
